# Copy to .env and fill in. Never commit .env.

# Optional services to start with plain `docker compose up`, comma-separated.
# "guard" adds the local Llama Guard (Ollama) used by the parent alert filter;
# "search" adds SearXNG for web search (also set ENABLE_WEB_SEARCH below).
# Leave empty to skip.
COMPOSE_PROFILES=
# Compose project name: prefixes container and volume names. Defaults to this
# folder's name. On Unraid's Compose Manager, set it to the stack name with
# "-" turned into "_" (docs/setup.md, "On Unraid").
# COMPOSE_PROJECT_NAME=
WEBUI_NAME="Family AI"
OPENWEBUI_PORT=3000
# 127.0.0.1 if a reverse proxy on this host terminates TLS (see docs/network.md)
OPENWEBUI_BIND=0.0.0.0
# LiteLLM admin UI, on this host's loopback only: http://localhost:4000/ui
LITELLM_PORT=4000
# Set a username/password for the admin UI
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=

# openssl rand -hex 32
WEBUI_SECRET_KEY=
# Must start with sk-   e.g. sk-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=
POSTGRES_PASSWORD=

# Use a dedicated API key for this stack so its spend is easy to see
# (and easy to revoke) in the provider console.
ANTHROPIC_API_KEY=

# Open WebUI connections, one per LiteLLM key: yours first, then each kid.
# Three lists in the same order: URLs and keys separated by ";", configs keyed
# by position ("0", "1", ...). The prefix becomes the model name prefix, e.g.
# alex.claude-kids. Keys come from scripts/create-parent-key.sh and
# create-kid-key.sh. Single quotes keep the JSON literal. See docs/setup.md.
OPENAI_API_BASE_URLS=http://litellm:4000/v1
OPENAI_API_KEYS=
OPENAI_API_CONFIGS='{"0":{"prefix_id":"parent"}}'
# With two kids it looks like:
# OPENAI_API_BASE_URLS=http://litellm:4000/v1;http://litellm:4000/v1;http://litellm:4000/v1
# OPENAI_API_KEYS=sk-parent...;sk-alex...;sk-sam...
# OPENAI_API_CONFIGS='{"0":{"prefix_id":"parent"},"1":{"prefix_id":"alex"},"2":{"prefix_id":"sam"}}'

# Optional: OpenRouter for non-Anthropic models. Same advice: a dedicated key,
# with a monthly limit and a guardrail. See docs/openrouter.md.
OPENROUTER_API_KEY=

# Parents' models (claude-sonnet, claude-opus, ...) use separate keys, so
# parent spend has its own limits. Reuse the values above if you don't care.
ANTHROPIC_API_KEY_PARENTS=
OPENROUTER_API_KEY_PARENTS=

# Web search for parents (kids stay off). Needs "search" in COMPOSE_PROFILES.
# See docs/setup.md step 9.
ENABLE_WEB_SEARCH=false
# openssl rand -hex 32
SEARXNG_SECRET=
